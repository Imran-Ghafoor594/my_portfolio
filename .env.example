# GROQ account: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Upstash Redis: required to safely enable Groq requests and 5-call allowance.
# Get both values from the same Upstash Redis database.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Use a random secret, at least 32 bytes; never push it to GitHub.
# Example: openssl rand -hex 32
CHAT_VISITOR_SECRET=
